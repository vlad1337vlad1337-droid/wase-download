# Standalone website only. Do not use concurrently with another public :443 listener.
wase.download {
    root * /var/www/wase-download/current
    encode zstd gzip
    tls {
        protocols tls1.2 tls1.2
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://mc.yandex.ru; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @pages not path /assets/*
    header @pages Cache-Control "no-cache"
    handle /api/* {
        reverse_proxy 127.0.0.1:5189 {
            header_up X-Real-IP {remote_host}
        }
    }
    file_server
}
