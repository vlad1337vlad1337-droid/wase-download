[Unit]
Description=Wase Download isolated converter API
After=docker.service network.target
Requires=docker.service

[Service]
Type=simple
User=wase-download
Group=wase-download
SupplementaryGroups=docker
WorkingDirectory=/opt/wase-download
Environment=PUBLIC_ORIGINS=https://wase.download,https://www.wase.download
Environment=API_PORT=5189
Environment=CONVERTX_IMAGE=wase-converter:20261002
Environment=MAX_FILE_MB=100
Environment=MAX_CONCURRENT=1
Environment=CONVERT_CPU=0.25
Environment=CONVERT_CGROUP=wase-conversion.slice
# Optional, root-owned 0600 file for secrets such as ALERT_WEBHOOK_URL.
EnvironmentFile=-/etc/wase-download/api.env
MemoryMax=512M
CPUQuota=15%
CPUWeight=10
Slice=wase-conversion.slice
# Remove job containers/volumes/directories left by a crash. "-": the API also
# recovers a paused intake by itself, so a Docker hiccup must not block start.
ExecStartPre=-/bin/sh /opt/wase-download/backend/cleanup-stale-jobs.sh
ExecStart=/usr/bin/node /opt/wase-download/backend/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
